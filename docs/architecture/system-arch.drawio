          <mxGeometry x="40" y="40" width="1220" height="330" as="geometry"/>
        </mxCell>

        <mxCell id="agents" value="Agents&#10;(5-10 per project)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="160" height="60" as="geometry"/>
