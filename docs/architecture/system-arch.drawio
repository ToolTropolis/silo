<mxfile host="app.diagrams.net">
  <diagram name="system-arch" id="silo-system-arch">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ================= Shared backing services column (right) ================= -->
        <mxCell id="svc_col" value="Shared backing services" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fillColor=#ebf3fb;strokeColor=#6c8ebf;dashed=1;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1290" y="40" width="380" height="1100" as="geometry"/>
        </mxCell>

        <mxCell id="registry" value="internal/registry&#10;TenantRegistry + Locker&#10;rqlite (3-node, Raft HA)&#10;project to bucket+key map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1330" y="90" width="300" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="kms" value="internal/kms&#10;KeyManager&#10;Vault&#10;per-project SSE keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1330" y="210" width="300" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="seaweedfs" value="internal/backend&#10;DurableBackend&#10;SeaweedFS (S3-compatible)&#10;bucket-per-project (silo-&lt;id&gt;)&#10;versioned, ETag CAS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="330" width="300" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="isolation_note" value="Isolation: bucket-per-project + per-project scoped&#10;S3 credential + per-project SSE key. One project's&#10;credential cannot reach another project's bucket." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="460" width="300" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="distilations" value="Proposals output&#10;_distilations/&lt;run-id&gt;/&#10;(separate namespace,&#10;live store untouched)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1330" y="580" width="300" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="distil_invariant" value="Core invariant: input store is never modified by&#10;a run; proposals only reach memory via&#10;human-approved promotion." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="690" width="300" height="80" as="geometry"/>
        </mxCell>

        <!-- ================= ZONE 1: Runtime read/write path ================= -->
