        <mxCell id="siloctl_onboard" value="siloctl onboard (cmd)&#10;internal/admin&#10;registry record -&gt; SSE key -&gt;&#10;versioned bucket -&gt; scoped cred&#10;(atomic, rollback on failure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
