        <mxCell id="client_sdk" value="pkg/client&#10;agent-facing SDK&#10;(Read / Write / List / Search)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="220" height="70" as="geometry"/>
