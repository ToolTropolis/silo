          <mxGeometry x="640" y="130" width="240" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="cache" value="internal/cache&#10;LocalCache (bbolt)&#10;content bucket + FIFO&#10;offline write queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="260" width="240" height="80" as="geometry"/>
